# Secret used to sign session JWTs - set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Key used to encrypt stored LDAP service-account passwords at rest
ENCRYPTION_KEY=change-me-to-a-long-random-string

# Initial local admin account - created once on first run only
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

# Set to "true" once the app is served over HTTPS so cookies are marked Secure
COOKIE_SECURE=false

# Number of reverse proxy hops in front of this app (nginx, Traefik, a PaaS
# router, load balancer, etc.), e.g. "1". Leave unset if the app is reached
# directly. Needed so Express can resolve the real client IP correctly;
# without it, requests that carry an X-Forwarded-For header can fail.
TRUST_PROXY=

# Console log verbosity: error | warn | info (default) | debug | silent
LOG_LEVEL=info

PORT=3000
DATA_DIR=/app/data
